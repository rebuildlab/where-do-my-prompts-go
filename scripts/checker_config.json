{
  "_comment": "ignore_patterns are regexes stripped from each line before comparing, to cut noise from counters and timestamps. extra_urls are checked even if no vendor field cites them.",
  "ignore_patterns": [
    "\\b\\d{1,3}(,\\d{3})+\\b(?=\\s*(GitHub stars|companies|SDK installs|Docker pulls))",
    "\\b\\d+(\\.\\d+)?[MK]\\+?\\s*(SDK installs per month|Docker pulls)",
    "^(Disappointed|Neutral|Smiley) Reaction$",
    "^[😞😐😃]$",
    "^Fireworks - Privacy Policy$",
    "^\\d+(\\.\\d+)?[kKM]$"
  ],
  "extra_urls": [
    "https://trustcenter.cohere.com/subprocessors",
    "https://cohere.com/privacy",
    "https://assets.ctfassets.net/8aevphvgewt8/9rRh60u9m8AJGCKPHSnkI/f665de2992d6aa66bab425d19a559dd1/TPL-202510-GitHubDataProtectionAgreement.pdf",
